# Python
__pycache__/
*.py[cod]
.venv/

# Build output (build.py writes everything under build\)
build/
dist/

# Third-party programs (yt-dlp, FFmpeg, Deno) - fetched by prepare_vendor.py
vendor/

# Local data, state and logs
data/
*.log

# Internal work records per version (contain local paths); never published
docs/*/handoff/

# Old test outputs (from before the sandbox; still on disk in old checkouts)
verification/*.json
verification/collection-test/
verification/packaged-collection/

# Never publish cookies
*cookies*.txt
cookies/
